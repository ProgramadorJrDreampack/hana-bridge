# ─────────────────────────────────────────────────────────────────────────
# HANA Bridge — plantilla de variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# El `.env` está en .gitignore (NUNCA se commitea).
# ─────────────────────────────────────────────────────────────────────────

# ─── Autenticación del bridge ───────────────────────────────────────────
API_TOKEN=change-me

# ─── Conexión a SAP HANA ────────────────────────────────────────────────
HANA_HOST=X.X.X.X
HANA_PORT=XXXXX
HANA_USER=XXXXXXXXX
HANA_PASSWORD=XXXXXXXXX
HANA_ENCRYPT=true
HANA_SSL_VALIDATE=false

# ─── Pool de conexiones ─────────────────────────────────────────────────
POOL_SIZE=5
POOL_ACQUIRE_TIMEOUT_SECONDS=10

# ─── Whitelist y consultas ──────────────────────────────────────────────
ALLOWED_SCHEMAS=XXXXXXXXX
DEFAULT_SCHEMA=XXXXXXXXXX
WHITELIST_CACHE_TTL_SECONDS=300
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20

# ─── Observabilidad ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
ERROR_LOG_FILE=logs/errors.log
APP_ENV=development
